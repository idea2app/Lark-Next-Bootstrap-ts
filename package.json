{
  "name": "@idea2app/lark-next-bootstrap-ts",
  "version": "2.4.0",
  "description": "Lark project scaffold based on TypeScript, React, Next.js, Bootstrap & Serwist.",
  "private": true,
  "engines": {
    "node": "^22.22.1 || >=23.2.0"
  },
  "dependencies": {
    "@git-diff-view/file": "^0.1.8",
    "@git-diff-view/react": "^0.1.8",
    "@khmyznikov/pwa-install": "^0.7.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.6",
    "@sentry/nextjs": "^11.12.0",
    "@serwist/next": "^9.5.13",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.51.0",
    "file-type": "^22.3.0",
    "formidable": "^3.5.4",
    "idea-react": "^3.0.0-rc.3",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.3.0",
    "koa-jwt": "^4.0.4",
    "koajax": "^3.3.1",
    "less": "^4.9.1",
    "less-loader": "^13.1.0",
    "lit": "^3.3.3",
    "lodash": "^4.18.1",
    "marked": "^18.2.0",
    "mime": "^4.1.2",
    "mobx": "^7.1.7",
    "mobx-github": "^0.7.1",
    "mobx-i18n": "^0.7.9",
    "mobx-lark": "^2.10.2",
    "mobx-react": "^10.0.4",
    "mobx-react-helper": "^0.5.4",
    "mobx-restful": "^2.1.5",
    "mobx-restful-table": "^3.0.0-rc.3",
    "next": "16.4.6",
    "next-ssr-middleware": "^1.1.5",
    "next-with-less": "^3.0.1",
    "react": "^19.3.1",
    "react-bootstrap-editor": "^3.0.0-rc.0",
    "react-dom": "^19.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "undici": "^8.12.4",
    "web-utility": "^4.8.1",
    "webpack": "^5.112.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@softonus/prettier-plugin-duplicate-remover": "^1.1.2",
    "@types/formidable": "^3.5.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa": "^3.0.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-idea2app-next-js": "^0.1.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-css-order": "^2.2.0",
    "serwist": "^9.5.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "plugins": [
      "prettier-plugin-css-order",
      "@softonus/prettier-plugin-duplicate-remover"
    ]
  },
  "lint-staged": {
    "*.{html,md,less,json,yml,js,mjs,ts,tsx}": "prettier --write",
    "*.{js,mjs,ts,tsx}": "eslint --fix"
  },
  "scripts": {
    "prepare": "husky",
    "install": "next typegen --webpack",
    "dev": "next dev --webpack",
    "build": "cross-env CI=true  next build --webpack",
    "start": "next start",
    "test": "lint-staged  &&  tsc --noEmit",
    "pack-image": "docker build -t idea2app/lark-next-bootstrap-ts:latest .",
    "container": "docker rm -f lark-next-bootstrap-ts  &&  docker run --name lark-next-bootstrap-ts -p 3000:3000 -d idea2app/lark-next-bootstrap-ts:latest"
  }
}
